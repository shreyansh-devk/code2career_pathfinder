# Local development only. Production rejects local identity and filesystem storage.
ENABLE_LOCAL_AUTH=true
LOCAL_DATABASE_PATH=.data/postgres
# Development seed accounts use this password. Change it before sharing a laptop.
DEV_ACCOUNT_PASSWORD=pathfinder-local-2026

# Managed production identity and PostgreSQL, provision separately.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
# Set the exact public HTTPS origin for production CSRF checks, no trailing path.
APP_ORIGIN=
# Comma-separated exact origins when using separate surface domains.
APP_ORIGINS=
USER_APP_URL=
ADMIN_APP_URL=
ORG_APP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Keep keys server-side. OpenRouter takes precedence when configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional Gateway or CodeCraft configuration when OpenRouter is unset.
AI_GATEWAY_API_KEY=
AI_MODEL=
# CodeCraft's OpenAI-compatible chat API, using the supplied Anthropic-named variables.
# Takes precedence over Gateway when all three values are configured.
ANTHROPIC_BASE_URL=https://codecraftapi.com/v1
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-4.8
# Token/output limits and daily per-user request caps are enforced server-side.
AI_DAILY_LIMIT=10

# Exact Clerk user IDs, comma-separated. Never accept roles from signup input.
PLATFORM_ADMIN_IDS=
