{
  "name": "code2career-pathfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "seed:dev": "node --import tsx scripts/seed.ts",
    "test:load": "node scripts/load-quiz.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.110",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@clerk/nextjs": "7.9.14",
    "@electric-sql/pglite": "0.5.8",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.137",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
